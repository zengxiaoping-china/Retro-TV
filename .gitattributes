# Normalize line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are stored untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.mp3 binary
*.wav binary
*.flac binary
*.mp4 binary
*.webm binary
*.mkv binary
*.zip binary
*.exe binary
*.dll binary
